{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/sigil.py": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/sky/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300" }]
    },
    {
      "source": "/rag/metadata.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300" }]
    }
  ]
}
